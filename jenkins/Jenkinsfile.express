pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  triggers { githubPush() }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Install') { steps { sh 'npm ci' } }
    stage('Validate') { steps { sh 'node --check server.js' } }
    stage('Deploy') { steps { sh 'sudo rsync -a --delete server.js package.json /opt/tutedude/express/ && cd /opt/tutedude/express && npm ci --omit=dev && (pm2 restart express || pm2 start server.js --name express) && pm2 save' } }
  }
  post { always { cleanWs() } }
}
