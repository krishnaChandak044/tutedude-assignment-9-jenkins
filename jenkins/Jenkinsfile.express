pipeline { agent any; options { timestamps(); disableConcurrentBuilds() }; triggers { githubPush() }; stages { stage('Checkout') { steps { checkout scm } }; stage('Install') { steps { dir('frontend') { sh 'npm ci' } } }; stage('Validate') { steps { dir('frontend') { sh 'node --check server.js' } } }; stage('Deploy') { steps { sh 'rsync -a --delete frontend/ /opt/tutedude/express/ && cd /opt/tutedude/express && npm ci --omit=dev && (pm2 restart express || pm2 start server.js --name express) && pm2 save' } } }; post { always { cleanWs() } } }
